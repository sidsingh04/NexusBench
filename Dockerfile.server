# Dockerfile.server — builds the control-plane, consumer, and worker binaries.
#
# Three binaries are produced from one image to keep the layer cache efficient:
#   /app/server   — NexusBench control plane  (cmd/server)
#   /app/consumer — Metrics consumer          (cmd/consumer)
#   /app/worker   — Benchmark worker          (cmd/worker)   ← Phase 3
#
# docker-compose service entrypoints:
#   control-plane:    ["/app/server"]   (default)
#   metrics-consumer: ["/app/consumer"]
#   worker:           ["/app/worker"]

FROM golang:1.25-alpine AS builder

WORKDIR /src

# Cache the dependency download layer separately from the build layer.
# This layer is only invalidated when go.mod or go.sum change.
COPY go.mod go.sum ./
RUN go mod download

COPY . .

# Build all three binaries in one RUN to share the module cache across all.
RUN CGO_ENABLED=0 GOOS=linux go build \
        -ldflags="-s -w" \
        -o /app/server \
        ./cmd/server \
    && CGO_ENABLED=0 GOOS=linux go build \
        -ldflags="-s -w" \
        -o /app/consumer \
        ./cmd/consumer \
    && CGO_ENABLED=0 GOOS=linux go build \
        -ldflags="-s -w" \
        -o /app/worker \
        ./cmd/worker

# ── Runtime image ──────────────────────────────────────────────────────────────
FROM alpine:3.20

RUN apk add --no-cache ca-certificates curl

# Copy all three binaries into the runtime image.
COPY --from=builder /app/server   /app/server
COPY --from=builder /app/consumer /app/consumer
COPY --from=builder /app/worker   /app/worker

RUN addgroup -g 1001 nexus && adduser -D -u 1001 -G nexus nexus

EXPOSE 8080

# Run as root so the control-plane and worker can access /var/run/docker.sock
# to manage sandbox containers. The socket is owned by root on the host
# and Docker Desktop does not expose a docker group inside containers.
USER root

# Default entrypoint runs the control plane.
# Override with ["/app/consumer"] or ["/app/worker"] for other services.
ENTRYPOINT ["/app/server"]
