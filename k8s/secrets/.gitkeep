# k8s/secrets/.gitkeep
#
# Secrets are NOT stored in this repository.
#
# How secrets are managed:
#
#   Local dev:
#     kubectl create secret generic nexusbench-secrets \
#       --namespace nexusbench \
#       --from-literal=timescale-dsn='postgres://nexus:<password>@timescaledb:5432/nexusbench' \
#       --from-literal=redpanda-sasl-password='' \
#       --dry-run=client -o yaml | kubectl apply -f -
#
#   CI/CD (Stage 4.4):
#     Secrets are injected from GitHub Actions Environments (encrypted at rest).
#     The deploy.yml workflow runs the kubectl command above with values from
#     ${{ secrets.TIMESCALE_DSN }} and ${{ secrets.REDPANDA_SASL_PASSWORD }}.
#     They never appear in workflow logs (GitHub masks them) or in this repo.
#
#   Production:
#     Use Sealed Secrets (https://github.com/bitnami-labs/sealed-secrets) or
#     Google Secret Manager + External Secrets Operator to sync secrets into
#     the cluster from a secrets manager — not from plaintext yaml files.
#
# Required secret keys (all in secret/nexusbench-secrets):
#   timescale-dsn          — full PostgreSQL DSN for TimescaleDB
#   redpanda-sasl-password — SASL password for Redpanda (empty = no auth in dev)
