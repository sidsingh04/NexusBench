{
  "__inputs": [],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "11.0.0" },
    { "type": "datasource", "id": "postgres", "name": "PostgreSQL", "version": "1.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "datasource", "id": "loki", "name": "Loki", "version": "1.0.0" }
  ],
  "annotations": { "list": [] },
  "description": "NexusBench Contestant — algorithm latency, sandbox container health, and submission logs. Scoped to your submission ID.",
  "editable": false,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "title": "📈 Algorithm Performance — $submission_id",
      "type": "row"
    },

    {
      "datasource": { "type": "postgres", "uid": "nexusbench-timescaledb" },
      "description": "p50 / p90 / p99 order processing latency. A wide p50–p99 gap means your engine has occasional spikes — investigate lock contention or GC pauses.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 8 },
          "unit": "ms",
          "min": 0
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "p99_ms" }, "properties": [{ "id": "color", "value": { "fixedColor": "red",    "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "p90_ms" }, "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "p50_ms" }, "properties": [{ "id": "color", "value": { "fixedColor": "green",  "mode": "fixed" } }] }
        ]
      },
      "gridPos": { "h": 9, "w": 16, "x": 0, "y": 1 },
      "id": 2,
      "options": { "tooltip": { "mode": "multi" } },
      "targets": [{
        "datasource": { "type": "postgres", "uid": "nexusbench-timescaledb" },
        "format": "time_series",
        "rawSql": "SELECT\n  time AS \"time\",\n  p50_ns / 1e6 AS \"p50_ms\",\n  p90_ns / 1e6 AS \"p90_ms\",\n  p99_ns / 1e6 AS \"p99_ms\"\nFROM latency_windows\nWHERE $__timeFilter(time)\n  AND submission_id = '$submission_id'\nORDER BY time",
        "refId": "A"
      }],
      "title": "Latency Percentiles (ms)",
      "type": "timeseries"
    },

    {
      "datasource": { "type": "postgres", "uid": "nexusbench-timescaledb" },
      "description": "Most recent p99 latency for your submission.",
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green",  "value": null },
            { "color": "orange", "value": 10   },
            { "color": "red",    "value": 50   }
          ]}
        }
      },
      "gridPos": { "h": 3, "w": 4, "x": 16, "y": 1 },
      "id": 3,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "targets": [{
        "datasource": { "type": "postgres", "uid": "nexusbench-timescaledb" },
        "format": "time_series",
        "rawSql": "SELECT time, p99_ns/1e6 AS \"p99_ms\" FROM latency_windows WHERE submission_id='$submission_id' ORDER BY time DESC LIMIT 1",
        "refId": "A"
      }],
      "title": "Current p99",
      "type": "stat"
    },

    {
      "datasource": { "type": "postgres", "uid": "nexusbench-timescaledb" },
      "description": "Most recent p50 (median) latency.",
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green",  "value": null },
            { "color": "orange", "value": 5    },
            { "color": "red",    "value": 20   }
          ]}
        }
      },
      "gridPos": { "h": 3, "w": 4, "x": 20, "y": 1 },
      "id": 4,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "targets": [{
        "datasource": { "type": "postgres", "uid": "nexusbench-timescaledb" },
        "format": "time_series",
        "rawSql": "SELECT time, p50_ns/1e6 AS \"p50_ms\" FROM latency_windows WHERE submission_id='$submission_id' ORDER BY time DESC LIMIT 1",
        "refId": "A"
      }],
      "title": "Current p50",
      "type": "stat"
    },

    {
      "datasource": { "type": "postgres", "uid": "nexusbench-timescaledb" },
      "description": "Peak throughput achieved.",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red",    "value": null  },
            { "color": "orange", "value": 1000  },
            { "color": "green",  "value": 10000 }
          ]}
        }
      },
      "gridPos": { "h": 3, "w": 4, "x": 16, "y": 4 },
      "id": 5,
      "options": { "reduceOptions": { "calcs": ["max"] }, "colorMode": "background", "graphMode": "none" },
      "targets": [{
        "datasource": { "type": "postgres", "uid": "nexusbench-timescaledb" },
        "format": "time_series",
        "rawSql": "SELECT time, tps FROM latency_windows WHERE $__timeFilter(time) AND submission_id='$submission_id' ORDER BY time",
        "refId": "A"
      }],
      "title": "Peak TPS",
      "type": "stat"
    },

    {
      "datasource": { "type": "postgres", "uid": "nexusbench-timescaledb" },
      "description": "Total orders processed.",
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 3, "w": 4, "x": 20, "y": 4 },
      "id": 6,
      "options": { "reduceOptions": { "calcs": ["sum"] }, "colorMode": "value", "graphMode": "none" },
      "targets": [{
        "datasource": { "type": "postgres", "uid": "nexusbench-timescaledb" },
        "format": "time_series",
        "rawSql": "SELECT time, sample_n FROM latency_windows WHERE $__timeFilter(time) AND submission_id='$submission_id' ORDER BY time",
        "refId": "A"
      }],
      "title": "Total Orders Processed",
      "type": "stat"
    },

    {
      "datasource": { "type": "postgres", "uid": "nexusbench-timescaledb" },
      "description": "Throughput over time. Drops indicate your engine is falling behind the order stream.",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps", "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 8 }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "id": 7,
      "targets": [{
        "datasource": { "type": "postgres", "uid": "nexusbench-timescaledb" },
        "format": "time_series",
        "rawSql": "SELECT time, tps AS \"TPS\" FROM latency_windows WHERE $__timeFilter(time) AND submission_id='$submission_id' ORDER BY time",
        "refId": "A"
      }],
      "title": "Throughput (TPS)",
      "type": "timeseries"
    },

    {
      "datasource": { "type": "postgres", "uid": "nexusbench-timescaledb" },
      "description": "Min and max latency per window. A high max vs p99 gap means isolated extreme outliers.",
      "fieldConfig": {
        "defaults": {
          "unit": "ms", "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 1 }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "id": 8,
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "nexusbench-timescaledb" },
          "format": "time_series",
          "rawSql": "SELECT time, min_ns/1e6 AS \"min_ms\", max_ns/1e6 AS \"max_ms\", mean_ns/1e6 AS \"mean_ms\" FROM latency_windows WHERE $__timeFilter(time) AND submission_id='$submission_id' ORDER BY time",
          "refId": "A"
        }
      ],
      "title": "Min / Mean / Max Latency (ms)",
      "type": "timeseries"
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "id": 20,
      "title": "🐳 Sandbox Container Health — $submission_id",
      "type": "row"
    },

    {
      "datasource": { "type": "prometheus", "uid": "nexusbench-prometheus" },
      "description": "CPU cores per second consumed by your sandbox. If this flatlines at the quota ceiling your engine is CPU-throttled — the latency numbers are not representative of pure algorithmic performance.",
      "fieldConfig": {
        "defaults": {
          "unit": "short", "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 8 },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green",  "value": null },
            { "color": "orange", "value": 0.8  },
            { "color": "red",    "value": 0.95 }
          ]}
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 },
      "id": 21,
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "nexusbench-prometheus" },
        "expr": "sum by (name) (\n  rate(container_cpu_usage_seconds_total{\n    name=~\".*$submission_id.*\"\n  }[1m])\n)",
        "legendFormat": "CPU — {{name}}",
        "refId": "A"
      }],
      "title": "Sandbox CPU Usage",
      "type": "timeseries"
    },

    {
      "datasource": { "type": "prometheus", "uid": "nexusbench-prometheus" },
      "description": "RSS memory used by your sandbox container vs the allocated limit. If RSS approaches the limit your engine is at risk of OOM termination.",
      "fieldConfig": {
        "defaults": {
          "unit": "bytes", "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 8 }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 19 },
      "id": 22,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "nexusbench-prometheus" },
          "expr": "container_memory_rss{name=~\".*$submission_id.*\"}",
          "legendFormat": "RSS — {{name}}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "nexusbench-prometheus" },
          "expr": "container_spec_memory_limit_bytes{name=~\".*$submission_id.*\"}",
          "legendFormat": "Limit",
          "refId": "B"
        }
      ],
      "title": "Sandbox Memory RSS vs Limit",
      "type": "timeseries"
    },

    {
      "datasource": { "type": "prometheus", "uid": "nexusbench-prometheus" },
      "description": "Network bytes received by your sandbox — this is the order traffic coming in from the bot fleet.",
      "fieldConfig": { "defaults": { "unit": "Bps", "min": 0, "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 1 } } },
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 27 },
      "id": 23,
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "nexusbench-prometheus" },
        "expr": "sum by (name) (rate(container_network_receive_bytes_total{name=~\".*$submission_id.*\"}[1m]))",
        "legendFormat": "RX — {{name}}",
        "refId": "A"
      }],
      "title": "Sandbox Network RX",
      "type": "timeseries"
    },

    {
      "datasource": { "type": "prometheus", "uid": "nexusbench-prometheus" },
      "description": "Network bytes transmitted by your sandbox — this is the acknowledgement traffic going back to the bot fleet.",
      "fieldConfig": { "defaults": { "unit": "Bps", "min": 0, "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 1 } } },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 27 },
      "id": 24,
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "nexusbench-prometheus" },
        "expr": "sum by (name) (rate(container_network_transmit_bytes_total{name=~\".*$submission_id.*\"}[1m]))",
        "legendFormat": "TX — {{name}}",
        "refId": "A"
      }],
      "title": "Sandbox Network TX",
      "type": "timeseries"
    },

    {
      "datasource": { "type": "prometheus", "uid": "nexusbench-prometheus" },
      "description": "OOM events for your container. Any value above 0 means your engine was killed and restarted — results from that window are invalid.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "red",   "value": 1    }
          ]},
          "color": { "mode": "thresholds" }
        }
      },
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 33 },
      "id": 25,
      "options": { "reduceOptions": { "calcs": ["sum"] }, "colorMode": "background", "graphMode": "none", "orientation": "horizontal" },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "nexusbench-prometheus" },
        "expr": "increase(container_oom_events_total{name=~\".*$submission_id.*\"}[5m])",
        "legendFormat": "OOM events",
        "refId": "A"
      }],
      "title": "OOM Events (last 5 min)",
      "type": "stat"
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 37 },
      "id": 30,
      "title": "📋 Submission Logs — $submission_id",
      "type": "row"
    },

    {
      "datasource": { "type": "loki", "uid": "nexusbench-loki" },
      "description": "Logs from the consumer and control-plane that reference your submission ID. This shows what the platform observed while processing your orders.",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 38 },
      "id": 31,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [{
        "datasource": { "type": "loki", "uid": "nexusbench-loki" },
        "expr": "{job=\"docker\", submission_id=\"$submission_id\"}",
        "refId": "A"
      }],
      "title": "Logs for this Submission",
      "type": "logs"
    },

    {
      "datasource": { "type": "loki", "uid": "nexusbench-loki" },
      "description": "Error-level logs only for your submission. Start here when debugging a failed run.",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 50 },
      "id": 32,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [{
        "datasource": { "type": "loki", "uid": "nexusbench-loki" },
        "expr": "{job=\"docker\", submission_id=\"$submission_id\", level=\"ERROR\"}",
        "refId": "A"
      }],
      "title": "Error Logs — this Submission",
      "type": "logs"
    }

  ],

  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["nexusbench", "contestant", "phase2"],
  "templating": {
    "list": [
      {
        "current": {},
        "datasource": { "type": "postgres", "uid": "nexusbench-timescaledb" },
        "definition": "SELECT DISTINCT submission_id FROM latency_windows ORDER BY submission_id",
        "hide": 0,
        "includeAll": false,
        "label": "Your Submission",
        "name": "submission_id",
        "options": [],
        "query": "SELECT DISTINCT submission_id FROM latency_windows ORDER BY submission_id",
        "refresh": 2,
        "sort": 0,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-30m", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "NexusBench — Contestant",
  "uid": "nexusbench-contestant",
  "version": 1
}
